# Local Python runs use ./data. Compose always stores data in its /data volume.
QM_DATA_DIR=./data

# Optional guided-interview builder. No call occurs until an explicit test/send action.
# The base URL includes /v1; the app appends /chat/completions. Use a model supporting
# strict JSON-schema responses and max_completion_tokens. No default paid provider.
# Credentials stay in environment/ignored .env, or a mounted secret file; never in SQLite.
# QM_BUILDER_BASE_URL=https://your-provider.example/v1
# QM_BUILDER_MODEL=your-model
# QM_BUILDER_API_KEY=
# Use either API_KEY or API_KEY_FILE. In Docker, this path must exist inside the container.
# QM_BUILDER_API_KEY_FILE=/run/secrets/builder_api_key
# QM_BUILDER_TIMEOUT_SECONDS=20
# Maximum serialized request including schema (4096–65536 bytes); lower for your provider.
# QM_BUILDER_MAX_INPUT_BYTES=49152

# Optional local base-model advice. First run make model-setup (CPU, no training).
# Default setup prepares the verified 4B model in a separate directory. Copy ALL printed
# model settings, then start the advice Compose profile. Historical 0.8B remains opt-in.
# QM_LOCAL_BASE_URL=http://inference:8080/v1
# QM_LOCAL_MODEL_SHA256=
# QM_LOCAL_MODEL_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
# QM_LOCAL_MEMORY_LIMIT=6g
# QM_LOCAL_TIMEOUT_SECONDS=180
# Host Python base export reads the unchanged bundle here. Compose uses /model.
# QM_LOCAL_MODEL_DIR=./data/local-model-4b
# Optional comparison-only existing LoRA service; exact GGUF SHA and model alias
# qm-comparison-<SHA> must match. No training or active-model change occurs.
# QM_COMPARISON_BASE_URL=http://comparison:8080/v1
# QM_COMPARISON_MODEL_SHA256=

# Optional candidate CPU service, enabled by compose.training.yaml's training profile.
# QM_CANDIDATE_BASE_URL=http://candidate:8080
# Host-worker deployments share the SAME host data directory with the web app.
# Existing named-volume users must copy/verify their backup before changing storage.
# QM_TRAINING_DATA_DIR=./data/training-app
# QM_LOCAL_UID=1000
# QM_LOCAL_GID=1000
# Exact local image ID after building trainer/Dockerfile target standalone-runtime.
# Use docker image inspect quartermaster-standalone-runtime:m7 --format '{{.Id}}'.
QM_EXPORT_RUNTIME_IMAGE=

# Optional hosted adviser: separate from the optional builder. Supports strict
# JSON-schema chat completions and max_completion_tokens. No calls until project consent.
# QM_ADVISER_BASE_URL=https://your-provider.example/v1
# QM_ADVISER_MODEL=gpt-6-luna
# QM_ADVISER_REASONING_EFFORT=high
# QM_ADVISER_API_KEY=
# QM_ADVISER_API_KEY_FILE=/run/secrets/adviser_api_key
# QM_ADVISER_TIMEOUT_SECONDS=60
# Disable all hosted advice even if a project previously consented:
# QM_ADVISER_LOCAL_ONLY=true

# Muster is bundled into /collect in the same application. Its default storage
# is <QM_DATA_DIR>/muster, included in the ordinary data backup.
# QM_MUSTER_DATA_DIR=/absolute/path/to/separate/muster-data
# Optional extraction provider; separate from adviser/builder consent and credentials.
MUSTER_AI_BASE_URL=
MUSTER_AI_MODEL=
MUSTER_AI_API_KEY=
MUSTER_AI_REASONING_EFFORT=
