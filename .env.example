# Local Python runs use ./data. Compose always stores data in its /data volume.
QM_DATA_DIR=./data

# Optional guided-interview builder. No call occurs until an explicit test/send action.
# The base URL includes /v1; the app appends /chat/completions. Use a model supporting
# strict JSON-schema responses and max_completion_tokens. No default paid provider.
# Credentials stay in environment/ignored .env, or a mounted secret file; never in SQLite.
# QM_BUILDER_BASE_URL=https://your-provider.example/v1
# QM_BUILDER_MODEL=your-model
# QM_BUILDER_API_KEY=
# Use either API_KEY or API_KEY_FILE. In Docker, this path must exist inside the container.
# QM_BUILDER_API_KEY_FILE=/run/secrets/builder_api_key
# QM_BUILDER_TIMEOUT_SECONDS=20

# Optional local base-model advice. First run make model-setup (CPU, no training).
# Paste the SHA-256 printed by that command, then start the advice Compose profile.
# QM_LOCAL_BASE_URL=http://inference:8080/v1
# QM_LOCAL_MODEL_SHA256=
# QM_LOCAL_TIMEOUT_SECONDS=120

# Optional candidate CPU service, enabled by compose.training.yaml's training profile.
# QM_CANDIDATE_BASE_URL=http://candidate:8080
# Host-worker deployments share the SAME host data directory with the web app.
# Existing named-volume users must copy/verify their backup before changing storage.
# QM_TRAINING_DATA_DIR=./data/training-app
# QM_LOCAL_UID=1000
# QM_LOCAL_GID=1000
# Exact local image ID after building trainer/Dockerfile target standalone-runtime.
# Use docker image inspect quartermaster-standalone-runtime:m7 --format '{{.Id}}'.
QM_EXPORT_RUNTIME_IMAGE=
