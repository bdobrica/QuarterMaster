# Local Python runs use ./data. Compose always stores data in its /data volume.
QM_DATA_DIR=./data

# Reserved for the guided builder in Milestone 3. No provider is called in M0–2.
# Credentials stay in the environment; never commit your .env file.
# QM_BUILDER_BASE_URL=https://your-provider.example/v1
# QM_BUILDER_MODEL=your-model
# QM_BUILDER_API_KEY=
